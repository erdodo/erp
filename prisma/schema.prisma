generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  logo                 String?
  primaryColor         String                @default("#2563eb")
  secondaryColor       String                @default("#7c3aed")
  currency             String                @default("TRY")
  timezone             String                @default("Europe/Istanbul")
  language             String                @default("tr")
  isActive             Boolean               @default(true)
  onboardingDone       Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  customers            Customer[]
  dashboardLayouts     DashboardLayout[]
  departments          Department[]
  employees            Employee[]
  equipment            Equipment[]
  expenses             Expense[]
  expenseCategories    ExpenseCategory[]
  fieldServices        FieldService[]
  fiveSAudits          FiveSAudit[]
  inventoryCounts      InventoryCount[]
  inventoryItems       InventoryItem[]
  iotDevices           IoTDevice[]
  jobPostings          JobPosting[]
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]
  maintenanceSchedules MaintenanceSchedule[]
  materials            Material[]
  notifications        Notification[]
  printTemplates       PrintTemplate[]
  processFlows         ProcessFlow[]
  productionLines      ProductionLine[]
  productionMethods    ProductionMethod[]
  productionOrders     ProductionOrder[]
  projects             Project[]
  qualityChecks        QualityCheck[]
  qualityStandards     QualityStandard[]
  rentalProperties     RentalProperty[]
  retailStores         RetailStore[]
  roles                Role[]
  sales                Sale[]
  serviceRoutes        ServiceRoute[]
  stockItems           StockItem[]
  subscriptions        Subscription[]
  tasks                Task[]
  modules              TenantModule[]
  quotas               TenantQuota[]
  users                User[]
  vehicles             Vehicle[]
  virtualSaleChannels  VirtualSaleChannel[]
  warehouses           Warehouse[]
  workflows            Workflow[]
  okrPeriods           OkrPeriod[]
  okrTeams             OkrTeam[]
  okrObjectives        OkrObjective[]
  okrKeyResults        OkrKeyResult[]
}

model User {
  id             String         @id @default(cuid())
  tenantId       String?
  name           String
  email          String         @unique
  password       String?
  image          String?
  isSuperAdmin   Boolean        @default(false)
  isAdmin        Boolean        @default(false)
  isActive       Boolean        @default(true)
  roleId         String?
  employeeId     String?        @unique
  lastLoginAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  auditLogs      AuditLog[]
  expenses       Expense[]
  fieldServices  FieldService[]
  approvedLeaves LeaveRequest[] @relation("ApprovedLeaves")
  leaveRequests  LeaveRequest[]
  notifications  Notification[]
  tasks          Task[]         @relation("AssignedTasks")
  createdTasks   Task[]         @relation("CreatedTasks")
  workLogs       TaskWorkLog[]
  projectComments ProjectComment[]
  projectActivities ProjectActivity[]
  taskComments   TaskComment[]
  okrTeamMembers OkrTeamMember[]
  personalObjectives OkrObjective[] @relation("PersonalObjectives")
  ownedObjectives OkrObjective[] @relation("OwnedObjectives")
  ownedKeyResults OkrKeyResult[] @relation("OwnedKeyResults")
  okrPeriodComments OkrPeriodComment[]
  okrPeriodVotes OkrPeriodVote[]
  okrObjectiveComments OkrObjectiveComment[]
  ledTeams       OkrTeam[]      @relation("TeamLeader")
  projectMembers ProjectMember[]
  projectExpenses ProjectExpense[]
  employee       Employee?      @relation(fields: [employeeId], references: [id])
  role           Role?          @relation(fields: [roleId], references: [id])
  tenant         Tenant?        @relation(fields: [tenantId], references: [id])
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  module      String
  action      String
  description String?
  roles       RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model TenantModule {
  id             String   @id @default(cuid())
  tenantId       String
  module         String
  isActive       Boolean  @default(false)
  sortOrder      Int      @default(0)
  allowedActions String   @default("read,create,update,delete,export")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
}

model TenantQuota {
  id           String   @id @default(cuid())
  tenantId     String
  resource     String
  maxCount     Int      @default(100)
  currentCount Int      @default(0)
  isUnlimited  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, resource])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  module    String
  recordId  String?
  oldData   String?
  newData   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  title     String
  body      String
  type      String    @default("info")
  module    String?
  recordId  String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model Workflow {
  id            String              @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  triggerModule String
  triggerEvent  String
  conditions    String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  executions    WorkflowExecution[]
  steps         WorkflowStep[]
}

model WorkflowStep {
  id         String   @id @default(cuid())
  workflowId String
  sortOrder  Int
  action     String
  config     String
  createdAt  DateTime @default(now())
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model WorkflowExecution {
  id          String    @id @default(cuid())
  workflowId  String
  triggerData String?
  status      String    @default("running")
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  workflow    Workflow  @relation(fields: [workflowId], references: [id])
}

model DashboardLayout {
  id        String            @id @default(cuid())
  tenantId  String
  userId    String
  name      String            @default("Ana Dashboard")
  isDefault Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  widgets   DashboardWidget[]
}

model DashboardWidget {
  id         String          @id @default(cuid())
  layoutId   String
  title      String
  type       String
  dataSource String
  config     String
  x          Int             @default(0)
  y          Int             @default(0)
  w          Int             @default(4)
  h          Int             @default(3)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  layout     DashboardLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

model Customer {
  id            String                @id @default(cuid())
  tenantId      String
  type          String                @default("corporate")
  name          String
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String                @default("TR")
  taxNumber     String?
  taxOffice     String?
  website       String?
  pipelineStage String                @default("lead")
  assignedTo    String?
  tags          String?
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?
  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  contacts      CustomerContact[]
  interactions  CustomerInteraction[]
  fieldServices FieldService[]
  sales         Sale[]
  subscriptions Subscription[]
}

model CustomerContact {
  id         String    @id @default(cuid())
  customerId String
  name       String
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerInteraction {
  id         String    @id @default(cuid())
  customerId String
  userId     String?
  type       String
  subject    String
  body       String?
  date       DateTime  @default(now())
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model ProductionOrder {
  id           String            @id @default(cuid())
  tenantId     String
  orderNo      String
  productName  String
  quantity     Float
  unit         String            @default("adet")
  lineId       String?
  methodId     String?
  saleId       String?
  status       String            @default("planned")
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  iotReadings  IoTReading[]
  line         ProductionLine?   @relation(fields: [lineId], references: [id])
  method       ProductionMethod? @relation(fields: [methodId], references: [id])
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
}

model ProductionLine {
  id          String            @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  orders      ProductionOrder[]
}

model ProductionMethod {
  id          String            @id @default(cuid())
  tenantId    String
  name        String
  version     String            @default("1.0")
  description String?
  steps       String?
  materials   String?
  equipment   String?
  status      String            @default("draft")
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  orders      ProductionOrder[]
}

model QualityCheck {
  id          String           @id @default(cuid())
  tenantId    String
  standardId  String?
  type        String           @default("incoming")
  productName String
  batchNo     String?
  quantity    Float
  defectCount Float            @default(0)
  ppm         Float            @default(0)
  result      String           @default("pending")
  inspector   String?
  notes       String?
  checkedAt   DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  standard    QualityStandard? @relation(fields: [standardId], references: [id])
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
}

model QualityStandard {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  description String?
  maxPpm      Float          @default(1000)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  checks      QualityCheck[]
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
}

model Project {
  id          String             @id @default(cuid())
  tenantId    String
  name        String
  key         String?            // Short key like "ERP", "CRM"
  description String?
  category    String?            // software, construction, marketing etc
  color       String?            // hex color for project avatar
  status      String             @default("planning")
  budget      Float?
  currency    String             @default("TRY")
  progress    Float              @default(0)
  startDate   DateTime?
  endDate     DateTime?
  managerId   String?
  customerId  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  milestones  ProjectMilestone[]
  tasks       Task[]
  comments    ProjectComment[]
  activities  ProjectActivity[]
  sprints     ProjectSprint[]
  members     ProjectMember[]
  labels      ProjectLabel[]
  expenses    ProjectExpense[]
}

model ProjectMilestone {
  id        String    @id @default(cuid())
  projectId String
  name      String
  dueDate   DateTime?
  isDone    Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id              String        @id @default(cuid())
  tenantId        String
  projectId       String?
  parentId        String?
  sprintId        String?       // linked sprint
  title           String
  description     String?       // rich text / markdown
  type            String        @default("task") // epic, story, task, bug, subtask
  status          String        @default("todo")
  priority        String        @default("medium")
  storyPoints     Int?          // agile story points
  position        Int           @default(0) // ordering within column
  assignedTo      String?
  createdBy       String?
  dueDate         DateTime?
  estimatedHours  Float?
  actualHours     Float?
  tags            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  integrationType String?
  integrationId   String?
  assignee        User?         @relation("AssignedTasks", fields: [assignedTo], references: [id])
  creator         User?         @relation("CreatedTasks", fields: [createdBy], references: [id])
  parent          Task?         @relation("SubTasks", fields: [parentId], references: [id])
  subtasks        Task[]        @relation("SubTasks")
  project         Project?      @relation(fields: [projectId], references: [id])
  sprint          ProjectSprint? @relation(fields: [sprintId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  comments        TaskComment[]
  workLogs        TaskWorkLog[]
  activities      ProjectActivity[]
  labels          TaskLabel[]
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  userId    String?
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])
}

model Equipment {
  id                 String              @id @default(cuid())
  tenantId           String
  code               String
  name               String
  brand              String?
  model              String?
  serialNo           String?
  location           String?
  status             String              @default("active")
  purchaseDate       DateTime?
  purchasePrice      Float?
  currency           String              @default("TRY")
  warrantyUntil      DateTime?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  maintenanceRecords MaintenanceRecord[]
}

model MaintenanceSchedule {
  id            String              @id @default(cuid())
  tenantId      String
  equipmentId   String?
  name          String
  type          String              @default("preventive")
  frequency     String?
  lastDate      DateTime?
  nextDate      DateTime?
  estimatedCost Float?
  currency      String              @default("TRY")
  isActive      Boolean             @default(true)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  records       MaintenanceRecord[]
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
}

model MaintenanceRecord {
  id          String               @id @default(cuid())
  scheduleId  String?
  equipmentId String?
  technician  String?
  type        String               @default("preventive")
  description String
  cost        Float?
  currency    String               @default("TRY")
  duration    Float?
  completedAt DateTime             @default(now())
  createdAt   DateTime             @default(now())
  deletedAt   DateTime?
  equipment   Equipment?           @relation(fields: [equipmentId], references: [id])
  schedule    MaintenanceSchedule? @relation(fields: [scheduleId], references: [id])
}

model Warehouse {
  id         String          @id @default(cuid())
  tenantId   String
  name       String
  location   String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  stockItems StockItem[]
  movements  StockMovement[]
  rentals    RentalProperty[]
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
}

model StockItem {
  id          String          @id @default(cuid())
  tenantId    String
  warehouseId String?
  sku         String?
  name        String
  category    String?
  unit        String          @default("adet")
  quantity    Float           @default(0)
  minQuantity Float           @default(0)
  cost        Float?
  currency    String          @default("TRY")
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  saleItems   SaleItem[]
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id])
  movements   StockMovement[]
}

model StockMovement {
  id          String     @id @default(cuid())
  tenantId    String?
  itemId      String
  warehouseId String?
  type        String
  quantity    Float
  reason      String?
  reference   String?
  createdAt   DateTime   @default(now())
  item        StockItem  @relation(fields: [itemId], references: [id])
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
}

model Material {
  id             String    @id @default(cuid())
  tenantId       String
  code           String
  name           String
  description    String?
  category       String?
  unit           String    @default("kg")
  specifications String?
  suppliers      String?
  minOrderQty    Float?
  leadTimeDays   Int?
  cost           Float?
  currency       String    @default("TRY")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
}

model InventoryItem {
  id          String               @id @default(cuid())
  tenantId    String
  sku         String?
  barcode     String?
  name        String
  category    String?
  unit        String               @default("adet")
  quantity    Float                @default(0)
  minQuantity Float                @default(0)
  location    String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  countItems  InventoryCountItem[]
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
}

model InventoryCount {
  id          String               @id @default(cuid())
  tenantId    String
  name        String
  status      String               @default("draft")
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  items       InventoryCountItem[]
}

model InventoryCountItem {
  id         String         @id @default(cuid())
  countId    String
  itemId     String
  expected   Float          @default(0)
  actual     Float?
  difference Float?
  notes      String?
  count      InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  item       InventoryItem  @relation(fields: [itemId], references: [id])
}

model FiveSAudit {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  location    String?
  auditor     String?
  sort        Float     @default(0)
  setInOrder  Float     @default(0)
  shine       Float     @default(0)
  standardize Float     @default(0)
  sustain     Float     @default(0)
  totalScore  Float     @default(0)
  notes       String?
  actions     String?
  auditDate   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
}

model Department {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  managerId String?
  parentId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  parent    Department?  @relation("SubDepartments", fields: [parentId], references: [id])
  children  Department[] @relation("SubDepartments")
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  employees Employee[]
  okrObjectives OkrObjective[]
}

model Employee {
  id            String         @id @default(cuid())
  tenantId      String
  employeeNo    String
  name          String
  email         String?
  phone         String?
  departmentId  String?
  storeId       String?
  position      String?
  managerId     String?
  salary        Float?
  currency      String         @default("TRY")
  hireDate      DateTime?
  birthDate     DateTime?
  address       String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  department    Department?    @relation(fields: [departmentId], references: [id])
  store         RetailStore?   @relation(fields: [storeId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  vehicles      Vehicle[]
  serviceRoutes ServiceRoute[] @relation("ServiceDriver")
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[] @relation("EmployeeLeaves")
  fieldServices FieldService[]
  user          User?
}

model LeaveBalance {
  id            String   @id @default(cuid())
  tenantId      String?
  employeeId    String
  year          Int
  leaveType     String
  totalDays     Float    @default(0)
  usedDays      Float    @default(0)
  remainingDays Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id])
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([employeeId, year, leaveType])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  tenantId    String?
  employeeId  String
  requestedBy String?
  approvedBy  String?
  leaveType   String
  startDate   DateTime
  endDate     DateTime
  days        Float
  status      String    @default("pending")
  reason      String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  approver    User?     @relation("ApprovedLeaves", fields: [approvedBy], references: [id])
  employee    Employee  @relation("EmployeeLeaves", fields: [employeeId], references: [id])
  requester   User?     @relation(fields: [requestedBy], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model JobPosting {
  id           String           @id @default(cuid())
  tenantId     String
  title        String
  departmentId String?
  description  String?
  requirements String?
  status       String           @default("open")
  openedAt     DateTime         @default(now())
  closedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  applications JobApplication[]
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
}

model JobApplication {
  id         String      @id @default(cuid())
  postingId  String
  name       String
  email      String
  phone      String?
  cvUrl      String?
  status     String      @default("new")
  notes      String?
  appliedAt  DateTime    @default(now())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  interviews Interview[]
  posting    JobPosting  @relation(fields: [postingId], references: [id], onDelete: Cascade)
}

model Interview {
  id            String         @id @default(cuid())
  applicationId String
  scheduledAt   DateTime
  interviewers  String?
  type          String         @default("hr")
  result        String?
  notes         String?
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ProcessFlow {
  id          String           @id @default(cuid())
  tenantId    String
  title       String
  description String?
  fromDept    String?
  toDept      String?
  status      String           @default("open")
  priority    String           @default("medium")
  slaHours    Int?
  startedAt   DateTime         @default(now())
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  comments    ProcessComment[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
}

model ProcessComment {
  id          String      @id @default(cuid())
  processId   String
  userId      String?
  body        String
  attachments String?
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?
  process     ProcessFlow @relation(fields: [processId], references: [id], onDelete: Cascade)
}

model Sale {
  id            String       @id @default(cuid())
  tenantId      String
  saleNo        String
  customerId    String?
  status        String       @default("draft")
  totalAmount   Float        @default(0)
  currency      String       @default("TRY")
  discount      Float        @default(0)
  tax           Float        @default(0)
  notes         String?
  invoiceUrl    String?
  orderDate     DateTime     @default(now())
  deliveryDate  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  retailStoreId String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  retailStore   RetailStore? @relation(fields: [retailStoreId], references: [id])
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  items         SaleItem[]
}

model SaleItem {
  id          String     @id @default(cuid())
  saleId      String
  stockItemId String?
  name        String
  quantity    Float
  unit        String     @default("adet")
  unitPrice   Float
  totalPrice  Float
  notes       String?
  sale        Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id])
}

model RetailStore {
  id            String              @id @default(cuid())
  tenantId      String
  name          String
  address       String?
  phone         String?
  managerId     String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  employees     Employee[]
  expenses      Expense[]
  rentals       RentalProperty[]
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  transactions  RetailTransaction[]
  sales         Sale[]
  subscriptions Subscription[]
}

model RetailTransaction {
  id            String      @id @default(cuid())
  storeId       String
  type          String      @default("sale")
  items         String
  totalAmount   Float
  currency      String      @default("TRY")
  paymentMethod String      @default("cash")
  cashierId     String?
  receiptNo     String?
  transactedAt  DateTime    @default(now())
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?
  store         RetailStore @relation(fields: [storeId], references: [id])
}

model Subscription {
  id           String                @id @default(cuid())
  tenantId     String
  customerId   String?
  storeId      String?
  name         String
  plan         String?
  amount       Float
  currency     String                @default("TRY")
  billingCycle String                @default("monthly")
  status       String                @default("active")
  startDate    DateTime
  nextRenewal  DateTime?
  endDate      DateTime?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
  customer     Customer?             @relation(fields: [customerId], references: [id])
  store        RetailStore?          @relation(fields: [storeId], references: [id])
  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  renewals     SubscriptionRenewal[]
}

model SubscriptionRenewal {
  id             String       @id @default(cuid())
  subscriptionId String
  amount         Float
  currency       String       @default("TRY")
  renewedAt      DateTime     @default(now())
  nextRenewal    DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model RentalProperty {
  id            String           @id @default(cuid())
  tenantId      String
  name          String
  type          String           @default("office")
  ownershipType String           @default("leased_to_tenant")
  address       String?
  area          Float?
  storeId       String?
  warehouseId   String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
  contracts     RentalContract[]
  store         RetailStore?     @relation(fields: [storeId], references: [id])
  warehouse     Warehouse?       @relation(fields: [warehouseId], references: [id])
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
}

model RentalContract {
  id         String          @id @default(cuid())
  propertyId String
  tenantName String
  amount     Float
  currency   String          @default("TRY")
  startDate  DateTime
  endDate    DateTime?
  isActive   Boolean         @default(true)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  property   RentalProperty  @relation(fields: [propertyId], references: [id])
  payments   RentalPayment[]
}

model RentalPayment {
  id         String         @id @default(cuid())
  contractId String
  amount     Float
  currency   String         @default("TRY")
  dueDate    DateTime
  paidAt     DateTime?
  status     String         @default("pending")
  notes      String?
  createdAt  DateTime       @default(now())
  deletedAt  DateTime?
  contract   RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model VirtualSaleChannel {
  id        String             @id @default(cuid())
  tenantId  String
  name      String
  platform  String?
  url       String?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  orders    VirtualSaleOrder[]
}

model VirtualSaleOrder {
  id           String             @id @default(cuid())
  channelId    String
  orderNo      String
  customerName String?
  items        String
  totalAmount  Float
  currency     String             @default("TRY")
  status       String             @default("new")
  trackingNo   String?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  channel      VirtualSaleChannel @relation(fields: [channelId], references: [id])
}

model Vehicle {
  id                      String         @id @default(cuid())
  tenantId                String
  plate                   String
  brand                   String?
  model                   String?
  year                    Int?
  fuelType                String         @default("gasoline")
  driverId                String?
  status                  String         @default("active")
  insuranceExpiry         DateTime?
  inspectionExpiry        DateTime?
  notes                   String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  deletedAt               DateTime?
  fuelRecords             FuelRecord[]
  expenses                Expense[]
  serviceRouteAssignments ServiceRoute[]
  fieldServices           FieldService[]
  driver                  Employee?      @relation(fields: [driverId], references: [id])
  tenant                  Tenant         @relation(fields: [tenantId], references: [id])
}

model FuelRecord {
  id        String    @id @default(cuid())
  vehicleId String
  liters    Float
  cost      Float
  currency  String    @default("TRY")
  odometer  Float?
  station   String?
  filledAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
}

model ServiceRoute {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  vehicleId    String?
  driverId     String?
  status       String    @default("planned")
  stops        String?
  path         String?
  passengerIds String?
  distance     Float?
  notes        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  vehicle      Vehicle?  @relation(fields: [vehicleId], references: [id])
  driver       Employee? @relation("ServiceDriver", fields: [driverId], references: [id])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  budget    Float?
  currency  String    @default("TRY")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  expenses  Expense[]
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
}

model Expense {
  id          String           @id @default(cuid())
  tenantId    String
  categoryId  String?
  userId      String?
  storeId     String?
  vehicleId   String?
  title       String
  amount      Float
  currency    String           @default("TRY")
  receiptUrl  String?
  status      String           @default("pending")
  approvedBy  String?
  approvedAt  DateTime?
  expenseDate DateTime         @default(now())
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  store       RetailStore?     @relation(fields: [storeId], references: [id])
  vehicle     Vehicle?         @relation(fields: [vehicleId], references: [id])
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  user        User?            @relation(fields: [userId], references: [id])
}

model FieldService {
  id          String    @id @default(cuid())
  tenantId    String
  customerId  String?
  assignedTo  String?
  employeeId  String?
  vehicleId   String?
  type        String    @default("repair")
  title       String
  description String?
  status      String    @default("pending")
  priority    String    @default("medium")
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  signature   String?
  photos      String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  technician  User?     @relation(fields: [assignedTo], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id])
  employee    Employee? @relation(fields: [employeeId], references: [id])
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
}

model IoTDevice {
  id         String       @id @default(cuid())
  tenantId   String
  deviceId   String
  name       String
  type       String       @default("counter")
  location   String?
  lineId     String?
  isOnline   Boolean      @default(false)
  lastSeenAt DateTime?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  readings   IoTReading[]
}

model IoTReading {
  id                String           @id @default(cuid())
  deviceId          String
  productionOrderId String?
  value             Float
  unit              String           @default("adet")
  metadata          String?
  recordedAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())
  device            IoTDevice        @relation(fields: [deviceId], references: [id])
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
}

model PrintTemplate {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  type      String
  content   String
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
}

model TaskWorkLog {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  hours       Float
  description String?
  loggedAt    DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
}

model ProjectComment {
  id        String    @id @default(cuid())
  projectId String
  userId    String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
}

model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  taskId    String?
  userId    String
  action    String
  details   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user      User     @relation(fields: [userId], references: [id])
}

model ProjectSprint {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  goal        String?
  status      String    @default("planning") // planning, active, completed
  startDate   DateTime?
  endDate     DateTime?
  velocity    Float?    // completed story points
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member") // owner, lead, member, viewer
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model ProjectLabel {
  id        String      @id @default(cuid())
  projectId String
  name      String
  color     String      @default("#6366f1")
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]
}

model TaskLabel {
  taskId  String
  labelId String
  task    Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   ProjectLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model ProjectExpense {
  id          String   @id @default(cuid())
  projectId   String
  taskId      String?
  userId      String
  title       String
  amount      Float
  currency    String   @default("TRY")
  category    String   @default("other") // personnel, material, service, travel, other
  description String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
}

model OkrPeriod {
  id            String             @id @default(cuid())
  tenantId      String
  name          String
  type          String             // "quarterly" or "yearly"
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean            @default(true)
  votingActive  Boolean            @default(true)
  createdAt     DateTime           @default(now())
  deletedAt     DateTime?
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objectives    OkrObjective[]
  comments      OkrPeriodComment[]
  votes         OkrPeriodVote[]
}

model OkrTeam {
  id          String             @id @default(cuid())
  tenantId    String
  name        String
  description String?
  leaderId    String?
  createdAt   DateTime           @default(now())
  deletedAt   DateTime?
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leader      User?              @relation("TeamLeader", fields: [leaderId], references: [id])
  members     OkrTeamMember[]
  objectives  OkrObjective[]
}

model OkrTeamMember {
  id     String  @id @default(cuid())
  teamId String
  userId String
  team   OkrTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OkrObjective {
  id            String                @id @default(cuid())
  tenantId      String
  periodId      String
  title         String
  description   String?
  level         String                // "company", "department", "team", "personal"
  departmentId  String?
  teamId        String?
  userId        String?               // for personal objectives
  ownerId       String?
  progress      Float                 @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period        OkrPeriod             @relation(fields: [periodId], references: [id], onDelete: Cascade)
  department    Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team          OkrTeam?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  user          User?                 @relation("PersonalObjectives", fields: [userId], references: [id], onDelete: SetNull)
  owner         User?                 @relation("OwnedObjectives", fields: [ownerId], references: [id], onDelete: SetNull)
  keyResults    OkrKeyResult[]
  comments      OkrObjectiveComment[]
}

model OkrKeyResult {
  id           String       @id @default(cuid())
  tenantId     String
  objectiveId  String
  title        String
  description  String?
  initialValue Float        @default(0)
  currentValue Float        @default(0)
  targetValue  Float        @default(100)
  unit         String       @default("%")
  progress     Float        @default(0)
  ownerId      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objective    OkrObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  owner        User?        @relation("OwnedKeyResults", fields: [ownerId], references: [id], onDelete: SetNull)
}

model OkrPeriodComment {
  id        String    @id @default(cuid())
  periodId  String
  userId    String
  body      String
  createdAt DateTime  @default(now())
  period    OkrPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OkrPeriodVote {
  id        String    @id @default(cuid())
  periodId  String
  userId    String
  score     Int
  comment   String?
  createdAt DateTime  @default(now())
  period    OkrPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OkrObjectiveComment {
  id          String       @id @default(cuid())
  objectiveId String
  userId      String
  body        String
  createdAt   DateTime     @default(now())
  objective   OkrObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

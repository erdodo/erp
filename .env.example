# ─── VERİTABANI BAĞLANTISI ──────────────────────────────────────────────────
DATABASE_URL="postgresql://erp_user:erp_pass@localhost:5432/erp_db?schema=public"
# SQLite geliştirme ortamı için alternatif:
# DATABASE_URL="file:./dev.db"

# ─── NEXTAUTH (KİMLİK DOĞRULAMA) ──────────────────────────────────────────────
# openssl rand -base64 32 ile üretin
AUTH_SECRET="your-32-character-secret-key-change-me"
NEXTAUTH_SECRET="your-32-character-secret-key-change-me"
NEXTAUTH_URL="http://localhost:3000"

# ─── REDIS (PAYLAŞIMLI RATE LIMITING & ÖNBELLEKLEME) ─────────────────────────
# Birden çok container/serverless örneğinde paylaşımlı hız sınırlama için Redis URL'i.
# Boş bırakılırsa veya Redis kapalıysa otomatik olarak bellek-içi (in-memory) korumaya döner.
# Örnek: redis://localhost:6379 veya parola ile redis://:password@redis-host:6379/0
REDIS_URL="redis://localhost:6379"

# ─── YAPAY ZEKA SAĞLAYICILARI (OPSİYONEL) ────────────────────────────────────
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
